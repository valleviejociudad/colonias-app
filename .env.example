PORT=3001
JWT_SECRET=valle_viejo_colonias_secret_2025

# Configuración opcional de correo SMTP real (si se omite, usa Ethereal Test automáticamente en local)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_clave_de_aplicacion

# Configuración de Cloudinary para Banco de Imágenes (privado / authenticated)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Ruta opcional de la base de datos SQLite (en Railway con Volume montado en /data usar: /data/colonias.sqlite)
# DB_PATH=/data/colonias.sqlite
