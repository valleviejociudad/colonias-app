PORT=3001

# ⚠️ OBLIGATORIO EN PRODUCCIÓN: cadena aleatoria larga (mín. 32 caracteres).
# Para generar una: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar_por_secreto_largo_aleatorio

# Tiempo de expiración del token de sesión (ej. 12h, 24h, 7d)
JWT_EXPIRES_IN=12h

# NODE_ENV: "development" (local) o "production" (Railway)
NODE_ENV=development

# Usuario administrador inicial (se crea solo si la tabla de usuarios está vacía).
# Solo en producción. En local se crean usuarios de prueba automáticamente.
ADMIN_EMAIL=tu_correo@valleviejo.gob.ar
ADMIN_PASSWORD=contrasena_segura_minimo_8_caracteres

# Temporada activa (año que aparece en el nro. de ficha y en los datos por defecto)
TEMPORADA_ACTUAL=2027

# CORS: origen(s) del frontend separados por coma. Si no se define, se deshabilita CORS
# (el front se sirve desde el mismo origen que el back en producción).
# Ejemplo: https://colonias.valleviejo.gob.ar
# CORS_ORIGIN=

# Configuración de correo SMTP real.
# Si no se define, en desarrollo se usa Ethereal (buzón de prueba).
# En producción se recomienda Gmail con "Contraseña de Aplicación" o un servicio transaccional.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_clave_de_aplicacion
# El remitente que ven los destinatarios:
SMTP_FROM="Colonias de Verano - Municipalidad de Valle Viejo" <deportes@valleviejo.gob.ar>

# Configuración de Cloudinary para Banco de Imágenes (privado / authenticated).
# Si no se define, la galería queda deshabilitada y los endpoints devuelven 503.
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Ruta de la base de datos SQLite.
# ⚠️ En Railway: crear un Volume montado en /data y descomentar esta línea.
# Si no hay Volume, la base se borra en cada nuevo deploy.
# DB_PATH=/data/colonias.sqlite
