{
  "name": "colonias-de-verano-valle-viejo",
  "version": "1.0.0",
  "description": "Plataforma Web y PWA de Colonias de Verano y Fichas Médicas Digitales - Municipalidad de Valle Viejo",
  "main": "server/app.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/app.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/app.js",
    "install:all": "npm install && npm --prefix client install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
